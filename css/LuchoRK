.background {
    position: fixed;
    top: 0;
    width: 100%;
    height: 500px;
}

.portada {
    height: 278px;
    padding-left: 100px;
    padding-top: 100px;
}

.portada h1 {
    font-size: 100px;
    line-height: 1.1;
    margin-top: 0;
}

.portada h2  {
    font-size: 75px;
    font-style:italic;
    color: #595959;
}

.portada p {
    font-size: 20px;
    margin-bottom: 35px;
    color: var(--text-color);
}

#content {
    display: flex;
    flex-direction: column;
    padding: 10px 50px 30px 100px;
    position: relative;
    background: #ececec;
}

